# ============================================================
# MedPlus Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o arquivo .env no Git.
# ============================================================

# --- Banco de dados (Neon) ---
# Formato Neon: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/hms_db?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/hms_db
DATABASE_USERNAME=hms_user
DATABASE_PASSWORD=hms_pass

# --- JWT ---
# Use um segredo forte e único (mínimo 32 caracteres)
JWT_SECRET=troque-por-uma-chave-secreta-forte-de-pelo-menos-32-chars
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Separe múltiplas origens por vírgula (sem espaços)
# Exemplo produção: https://medplus.vercel.app,https://www.medplus.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# --- Render ---
# O Render injeta PORT automaticamente, não precisa definir aqui.
# PORT=8080
